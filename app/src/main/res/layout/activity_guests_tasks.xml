<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/party_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Party Planner"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="cursive"
            android:textColor="#E83E82"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/partyTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ניהול אורחים ומשימות 💗"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="האורחים שלי 🎀"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center" />

        <Button
            android:id="@+id/addGuestButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pink_button"
            android:backgroundTint="@null"
            android:text="＋ הוספת אורח"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/guestsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדיין לא הוספת אורחים"
            android:textColor="#B92D68"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="15dp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/guestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAB4CC"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="המשימות שלי ✨"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center" />

        <Button
            android:id="@+id/addTaskButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pink_button"
            android:backgroundTint="@null"
            android:text="＋ הוספת משימה"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tasksEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדיין לא הוספת משימות"
            android:textColor="#B92D68"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="15dp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/tasksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="חזרה למסיבה"
            android:textColor="#D82F73"
            android:textSize="17sp"
            android:textStyle="bold"
            android:padding="15dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
