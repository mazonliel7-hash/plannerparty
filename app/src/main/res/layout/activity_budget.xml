<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/party_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Party Planner"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="cursive"
            android:textColor="#E83E82"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ניהול התקציב 💗"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp" />

        <!-- סיכום התקציב -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/edit_text_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="סיכום התקציב"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#B92D68"
                android:gravity="center"
                android:layout_marginBottom="15dp" />

            <TextView
                android:id="@+id/budgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="תקציב כולל: 0.00 ₪"
                android:textSize="18sp"
                android:textColor="#B92D68"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/spentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="סך ההוצאות: 0.00 ₪"
                android:textSize="18sp"
                android:textColor="#E83E82"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/remainingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="יתרה: 0.00 ₪"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#B92D68"
                android:gravity="center"
                android:padding="8dp" />

            <ProgressBar
                android:id="@+id/budgetProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#E83E82"
                android:progressBackgroundTint="#F8D5E3" />

            <TextView
                android:id="@+id/budgetStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="הגדירי תקציב כדי לעקוב אחרי ההוצאות"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#B92D68"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

        <!-- כפתורי תקציב -->

        <Button
            android:id="@+id/setBudgetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הגדרת תקציב"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E83E82"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/addExpenseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הוספת הוצאה +"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B92D68"
            android:layout_marginTop="10dp" />

        <!-- סיכום קטגוריות -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סיכום לפי קטגוריות"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/categorySummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדיין אין הוצאות"
            android:textSize="16sp"
            android:textColor="#B92D68"
            android:padding="15dp"
            android:background="@drawable/edit_text_background" />

        <!-- רשימת הוצאות -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="רשימת ההוצאות"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/emptyExpensesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדיין לא הוספת הוצאות"
            android:textSize="17sp"
            android:textColor="#B92D68"
            android:gravity="center"
            android:padding="15dp" />

        <LinearLayout
            android:id="@+id/expensesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- חזרה -->

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="חזרה"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E83E82"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>