<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/party_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Party Planner"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="cursive"
            android:textColor="#E83E82"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ניהול התקציב 💗"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/edit_text_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="סיכום התקציב"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#B92D68"
                android:gravity="center"
                android:layout_marginBottom="15dp" />

            <TextView
                android:id="@+id/budgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="תקציב כולל: 0.00 ₪"
                android:textSize="18sp"
                android:textColor="#B92D68"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/spentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="סך ההוצאות: 0.00 ₪"
                android:textSize="18sp"
                android:textColor="#E83E82"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/remainingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="יתרה: 0.00 ₪"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#B92D68"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

        <Button
            android:id="@+id/setBudgetButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/pink_button"
            android:backgroundTint="@null"
            android:text="הגדרת תקציב"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/addExpenseButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/pink_button"
            android:backgroundTint="@null"
            android:text="הוספת הוצאה +"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ההוצאות שלי 💸"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#B92D68"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp" />

        <LinearLayout
            android:id="@+id/expensesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדיין לא נוספו הוצאות"
            android:textSize="16sp"
            android:textColor="#B92D68"
            android:gravity="center"
            android:padding="15dp" />

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:text="חזרה למסיבה"
            android:textColor="#D82F73"
            android:textSize="17sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp" />

    </LinearLayout>

</ScrollView>
