<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- הרשאה להצגת התראות -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- הרשאה לקבלת אירוע הפעלת המכשיר -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Party Planner"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LIEL">

        <!-- מסך הכניסה -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- מסך הבית -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- מסך המסיבה -->
        <activity
            android:name=".PartyActivity"
            android:exported="false" />

        <!-- מסך ניהול אורחים ומשימות -->
        <activity
            android:name=".GuestsTasksActivity"
            android:exported="false" />

        <!-- מסך התקציב -->
        <activity
            android:name=".BudgetActivity"
            android:exported="false" />

        <!-- מקבל ההתראות -->
        <receiver
            android:name=".PartyReminderReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
